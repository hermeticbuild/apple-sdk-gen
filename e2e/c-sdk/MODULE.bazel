module(name = "apple_sdk_c_e2e")

bazel_dep(name = "llvm")
bazel_dep(name = "sqlite3", version = "3.51.1.bcr.1")

git_override(
    module_name = "llvm",
    commit = "190fc9f5df9c86ed0f1db77e408381f427dcb829",
    patches = ["//:framework-free-link.patch"],
    patch_strip = 1,
    remote = "https://github.com/hermeticbuild/hermetic-llvm.git",
)

# Pass the archive as a file label so Bazel tracks changes at the fixed URL.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
new_local_repository(
    name = "sdk_output",
    build_file_content = 'exports_files(["MacOSX-C.sdk.tar.zst"])',
    path = "../../build/sdk",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "composed_sdk",
    add_prefix = "sysroot",
    build_file_content = 'exports_files(["MacOSX-C.sdk.tar.zst"])',
    files = {
        "MacOSX-C.sdk.tar.zst": "@sdk_output//:MacOSX-C.sdk.tar.zst",
        "sysroot/BUILD.bazel": "@llvm//3rd_party/macos_sdk:CLTools_macOSNMOS_SDK.BUILD.bazel",
    },
    strip_prefix = "MacOSX.sdk",
    urls = ["file:../../build/sdk/MacOSX-C.sdk.tar.zst"],
)

osx = use_extension("@llvm//extensions:osx.bzl", "osx")
override_repo(osx, macos_sdk = "composed_sdk")

register_toolchains("@llvm//toolchain:all")
