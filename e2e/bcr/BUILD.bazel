load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_test(
    name = "cares_test",
    size = "small",
    srcs = ["cares_test.c"],
    deps = ["@c-ares//:ares"],
)

cc_test(
    name = "curl_test",
    size = "small",
    srcs = ["curl_test.c"],
    linkopts = ["-Wl,-framework,CoreFoundation"],
    deps = ["@curl//:curl"],
)

test_suite(
    name = "framework_consumers",
    tests = ["cares_test", "curl_test"],
)
