Restore the Framework's CoreFoundation reexport. The Foundation image loaded
by macOS reports this LC_REEXPORT_DYLIB. CoreFoundation owns the constant
string class reference emitted by Clang for Objective-C string literals.
Apply to the pinned SDK Gen stub, preserving the qualified exports.

--- a/Foundation.tbd
+++ b/Foundation.tbd
@@ -9,4 +9,5 @@
     libraries:
       - '/usr/lib/libobjc.A.dylib'
+      - '/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation'
       - '/usr/lib/libSystem.B.dylib'
 exports:
